{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nodepad Context",
  "type": "object",
  "required": ["workspaceId", "hypotheses"],
  "properties": {
    "workspaceId": {
      "type": "string",
      "description": "Identifier of the Nodepad workspace"
    },
    "hypotheses": {
      "type": "array",
      "description": "List of hypotheses in the workspace",
      "items": {
        "$ref": "#/definitions/hypothesis"
      }
    },
    "evidence": {
      "type": "array",
      "description": "List of evidence in the workspace",
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "experiments": {
      "type": "array",
      "description": "List of experiments in the workspace",
      "items": {
        "$ref": "#/definitions/experiment"
      }
    },
    "brainContext": {
      "type": "object",
      "description": "Current brain context (beliefs, theories, etc.)",
      "additionalProperties": true
    },
    "graphNeighborhood": {
      "type": "object",
      "description": "Relevant subgraph of hypotheses and evidence",
      "additionalProperties": true
    }
  },
  "definitions": {
    "hypothesis": {
      "type": "object",
      "required": ["id", "statement", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "validated", "invalidated", "pending"]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/experiment"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "type", "content", "source"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "content": {
          "type": "object"
        },
        "source": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "experiment": {
      "type": "object",
      "required": ["id", "hypothesisId", "spec", "result"],
      "properties": {
        "id": {
          "type": "string"
        },
        "hypothesisId": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        },
        "result": {
          "type": "object"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "type": "string",
          "enum": ["confirmed", "refuted", "inconclusive"]
        }
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Result",
  "type": "object",
  "required": ["taskId", "agentId", "status", "artifacts"],
  "properties": {
    "taskId": {
      "type": "string",
      "description": "Identifier of the task this result corresponds to"
    },
    "agentId": {
      "type": "string",
      "description": "Identifier of the agent that produced this result"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial"],
      "description": "Status of the task execution"
    },
    "artifacts": {
      "type": "array",
      "description": "List of artifacts produced by the task",
      "items": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of artifact (e.g., evidence, hypothesis, experiment-spec, artifact-reference, handoff)"
          },
          "content": {
            "type": "object",
            "description": "Content of the artifact",
            "additionalProperties": true
          },
          "metadata": {
            "type": "object",
            "description": "Metadata about the artifact",
            "additionalProperties": true
          }
        }
      }
    },
    "evidenceSubmissions": {
      "type": "array",
      "description": "Evidence submissions to Nodepad",
      "items": {
        "$ref": "#/definitions/evidenceSubmission"
      }
    },
    "hypothesisProposals": {
      "type": "array",
      "description": "Hypothesis proposals to Nodepad",
      "items": {
        "$ref": "#/definitions/hypothesisProposal"
      }
    },
    "counterHypotheses": {
      "type": "array",
      "description": "Counter-hypothesis proposals to Nodepad",
      "items": {
        "$ref": "#/definitions/hypothesisProposal"
      }
    },
    "experimentSpecs": {
      "type": "array",
      "description": "Experiment specifications to Nodepad",
      "items": {
        "$ref": "#/definitions/experimentSpec"
      }
    },
    "experimentResults": {
      "type": "array",
      "description": "Experiment results to Nodepad",
      "items": {
        "$ref": "#/definitions/experimentResult"
      }
    },
    "researchGaps": {
      "type": "array",
      "description": "Research gaps identified",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Other artifacts (e.g., documents, prototypes)",
      "items": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": {
            "type": "string"
          },
          "content": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "description": "Handoffs to other agents or workflows",
      "items": {
        "type": "object",
        "required": ["to", "task"],
        "properties": {
          "to": {
            "type": "string",
            "description": "Agent or workflow identifier to handoff to"
          },
          "task": {
            "type": "object",
            "description": "Task description for the handoff",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "description": "Context for the handoff",
            "additionalProperties": true
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "description": "Log messages from the task execution",
      "items": {
        "type": "object",
        "required": ["timestamp", "level", "message"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "evidenceSubmission": {
      "type": "object",
      "required": ["type", "content", "source"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of evidence (e.g., interview, experiment, observation)"
        },
        "content": {
          "type": "object",
          "description": "Evidence content",
          "additionalProperties": true
        },
        "source": {
          "type": "string",
          "description": "Source of the evidence (e.g., customer interview ID, experiment ID)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the evidence (0-1)"
        }
      }
    },
    "hypothesisProposal": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": {
          "type": "string",
          "description": "The hypothesis statement"
        },
        "assumptions": {
          "type": "array",
          "description": "Assumptions underlying the hypothesis",
          "items": {
            "type": "string"
          }
        },
        "predictions": {
          "type": "array",
          "description": "Predictions made by the hypothesis",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "description": "Supporting evidence",
          "items": {
            "$ref": "#/definitions/evidenceSubmission"
          }
        }
      }
    },
    "experimentSpec": {
      "type": "object",
      "required": ["hypothesis", "design"],
      "properties": {
        "hypothesis": {
          "type": "string",
          "description": "The hypothesis being tested"
        },
        "design": {
          "type": "object",
          "description": "Experimental design",
          "additionalProperties": true
        },
        "variables": {
          "type": "object",
          "description": "Independent and dependent variables",
          "properties": {
            "independent": {
              "type": "string"
            },
            "dependent": {
              "type": "string"
            }
          }
        },
        "successCriteria": {
          "type": "object",
          "description": "Criteria for success/failure",
          "additionalProperties": true
        },
        "ethicalConsiderations": {
          "type": "string",
          "description": "Ethical considerations"
        }
      }
    },
    "experimentResult": {
      "type": "object",
      "required": ["experimentSpecId", "outcome"],
      "properties": {
        "experimentSpecId": {
          "type": "string",
          "description": "Reference to the experiment spec"
        },
        "outcome": {
          "type": "string",
          "enum": ["confirmed", "refuted", "inconclusive"],
          "description": "Outcome of the experiment"
        },
        "data": {
          "type": "object",
          "description": "Raw data collected",
          "additionalProperties": true
        },
        "analysis": {
          "type": "object",
          "description": "Analysis of the results",
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "description": "Evidence derived from the experiment",
          "items": {
            "$ref": "#/definitions/evidenceSubmission"
          }
        }
      }
    }
  },
  "additionalProperties": false
}

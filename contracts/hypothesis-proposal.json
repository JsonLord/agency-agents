{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypothesis Proposal",
  "type": "object",
  "required": ["statement"],
  "properties": {
    "statement": {
      "type": "string",
      "description": "The hypothesis statement"
    },
    "assumptions": {
      "type": "array",
      "description": "Assumptions underlying the hypothesis",
      "items": {
        "type": "string"
      }
    },
    "predictions": {
      "type": "array",
      "description": "Predictions made by the hypothesis",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "description": "Supporting evidence",
      "items": {
        "$ref": "#/definitions/evidenceSubmission"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "additionalProperties": true
    }
  },
  "definitions": {
    "evidenceSubmission": {
      "type": "object",
      "required": ["type", "content", "source"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of evidence (e.g., interview, experiment, observation)"
        },
        "content": {
          "type": "object",
          "description": "Evidence content",
          "additionalProperties": true
        },
        "source": {
          "type": "string",
          "description": "Source of the evidence (e.g., customer interview ID, experiment ID)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the evidence (0-1)"
        }
      }
    }
  },
  "additionalProperties": false
}

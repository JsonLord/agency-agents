{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "provider",
    "query",
    "source_url",
    "retrieved_at",
    "content_hash",
    "analysis_method",
    "idempotency_key",
    "actor"
  ],
  "properties": {
    "claim": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "analysis_method": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "polarity": {
      "enum": [
        "supporting",
        "contradicting",
        "neutral"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": "string"
    }
  }
}

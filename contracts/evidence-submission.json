{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Submission",
  "type": "object",
  "required": ["type", "content", "source"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Type of evidence (e.g., interview, experiment, observation, survey, metric)"
    },
    "content": {
      "type": "object",
      "description": "Evidence content",
      "additionalProperties": true
    },
    "source": {
      "type": "string",
      "description": "Source of the evidence (e.g., customer interview ID, experiment ID, metric name)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the evidence was collected or created"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in the evidence (0-1)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the evidence",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
